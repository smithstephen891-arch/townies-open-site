# Resend API key, used to email interest-form submissions.
# resend.com -> API Keys -> Create API Key.
# When unset in development, submissions are logged to the server console and
# the form still reports success. In production an unset key returns an error
# to the visitor unless Mailchimp captured them, so a misconfigured deploy is
# noticed on the first test rather than silently eating signups.
RESEND_API_KEY=

# Where interest-form submissions are emailed.
# Falls back to towniesopen@gmail.com when unset.
INTEREST_TO_EMAIL=

# The From address on those emails. Resend only sends from a domain verified
# in the Resend account, so towniesgolf.com has to be added there (Domains ->
# Add Domain, then the DKIM/SPF records at the registrar) before mail flows.
# Defaults to "Townies Open <noreply@towniesgolf.com>".
INTEREST_FROM_EMAIL=

# Mailchimp, for auto-adding interest signups to an audience.
# API key: mailchimp.com -> profile icon -> Account & billing -> Extras ->
# API keys. Audience ID: Audience -> Settings -> Audience name and defaults.
# Both are optional: when either is unset the interest email still sends and
# the Mailchimp step is skipped and logged.
MAILCHIMP_API_KEY=
MAILCHIMP_AUDIENCE_ID=

# Optional: Mailchimp data-center prefix, e.g. us21. Normally parsed from the
# API key's "-usXX" suffix; set this only if that ever fails.
MAILCHIMP_SERVER_PREFIX=
